# The versions of the proxies and tools the tests use, in one place (#393):
# the Makefile includes this file, the scripts under hack/ source it, the
# workflows read it (hack/versions-check.sh fails if one of these values is
# pinned anywhere else), and docs' "tested with" lines are checked against
# it (make docs-check: <!-- versions: KEY ... --> before the paragraph).
# `go run ./hack/versionsbump` bumps the entries with a "source:" comment to
# their latest upstream release (weekly, .github/workflows/versions.yaml).
# KEY=value only, no quotes or spaces: make and the shell read it alike.

# source: github-release envoyproxy/gateway
ENVOY_GATEWAY_VERSION=v1.9.3
# Envoy, for raw Envoy (also examples/raw-envoy/kubernetes.yaml's image,
# which hack/raw-envoy/e2e.sh checks against this).
# source: github-release envoyproxy/envoy
ENVOY_VERSION=v1.39.6
# source: github-release kubernetes-sigs/gateway-api
GATEWAY_API_VERSION=v1.7.0
# Traefik's Helm chart, and the Traefik version it deploys (its appVersion).
# source: helm-chart https://traefik.github.io/charts traefik TRAEFIK_VERSION
TRAEFIK_CHART_VERSION=41.6.1
TRAEFIK_VERSION=v3.7.13
# Istio's base, istiod and gateway charts.
# source: github-release istio/istio
ISTIO_VERSION=1.31.3
# HAProxy for hack/haproxy/e2e.sh (Docker), and the HAProxy Kubernetes
# Ingress Controller's chart for the kind e2e.
# source: docker-tag haproxy 3.2
HAPROXY_VERSION=3.2.26
# source: helm-chart https://haproxytech.github.io/helm-charts kubernetes-ingress
HAPROXY_CHART_VERSION=1.54.4
# The test apps.
# source: github-release traefik/whoami
WHOAMI_VERSION=v1.10.3
AGNHOST_VERSION=2.53
# Helm, in CI and the release workflow.
HELM_VERSION=v3.19.0
# kind, and the Kubernetes version of the local and upgrade clusters, as
# envtest's (the oldest tested; CI's e2e runs kind's newest).
# source: github-release kubernetes-sigs/kind
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.34.11@sha256:44e222ee2132dab25ff87301682f89eb82c7880ea3a1bf543bfe9708fd08d67d
ENVTEST_K8S_VERSION=1.34.1
# The runner of every CI job (make workflow-check, #400).
CI_RUNNER=ubuntu-24.04
# The workflows' and scripts' linters (make lint-scripts, #398).
# source: github-release rhysd/actionlint
ACTIONLINT_VERSION=v1.7.12
# source: github-release koalaman/shellcheck
SHELLCHECK_VERSION=v0.10.0
ZIZMOR_VERSION=1.16.3
