exit 1
# The built-in OWASP CRS v4, for the policies that tune it or add rules.
apiVersion: waf.inkwall.dev/v1alpha1
kind: ClusterWAFRuleSet
metadata:
  name: owasp-crs-v4
spec:
  source:
    builtin: crs-v4
---
# From the ingress-nginx ModSecurity settings of Ingress blog/blog.
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFPolicy
metadata:
  name: blog
  namespace: blog
spec:
  mode: Detect
  targetRefs:
  - group: traefik.io
    kind: IngressRoute
    name: blog
---
# From the ingress-nginx ModSecurity settings of Ingress files/cloud.
# 6 setting(s) were not migrated: see the summary of inkwallctl migrate.
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFRuleSet
metadata:
  name: cloud-modsecurity
  namespace: files
spec:
  source:
    seclang: |
      # annotation modsecurity-snippet, line 9
      SecRuleRemoveById 941000-942999
---
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFPolicy
metadata:
  name: cloud
  namespace: files
spec:
  body:
    maxBytes: 10485760
    onOversize: Allow
  mode: Detect
  ruleSets:
  - ref:
      kind: ClusterWAFRuleSet
      name: owasp-crs-v4
  - ref:
      kind: WAFRuleSet
      name: cloud-modsecurity
  targetRefs:
  - group: traefik.io
    kind: IngressRoute
    name: cloud
---
# From the ingress-nginx ModSecurity settings of Ingress shop/api.
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFRuleSet
metadata:
  name: api-modsecurity
  namespace: shop
spec:
  source:
    seclang: |
      # annotation modsecurity-snippet, line 2
      SecRule ARGS:debug "@streq true" "id:1100,phase:1,deny,status:403,msg:'debug switch'"
---
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFPolicy
metadata:
  name: api
  namespace: shop
spec:
  mode: Block
  ruleSets:
  - ref:
      kind: WAFRuleSet
      name: api-modsecurity
  targetRefs:
  - group: traefik.io
    kind: IngressRoute
    name: api
---
# From the ingress-nginx ModSecurity settings of Ingress shop/shop.
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFRuleSet
metadata:
  name: shop-modsecurity
  namespace: shop
spec:
  source:
    seclang: |
      # annotation modsecurity-snippet, line 20
      SecRule REQUEST_HEADERS:User-Agent "@contains sqlmap" "id:1004,phase:1,deny,status:403,msg:'sqlmap'"
---
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFPolicy
metadata:
  name: shop
  namespace: shop
spec:
  body:
    inspect: true
  exclusions:
  - ruleIDs:
    - 920350
    - 942430
  - ruleIDs:
    - 942100
    when:
      argument: password
  - ruleIDs:
    - 942100
    when:
      path: /search*
  - ruleIDs:
    - 932100
    when:
      argument: q
      path: /search*
  - ruleIDs:
    - 941100
    - 941101
    - 941110
    - 941120
    - 941130
    when:
      path: /cms/editor*
  mode: Block
  ruleSets:
  - inboundAnomalyThreshold: 10
    paranoiaLevel: 2
    ref:
      kind: ClusterWAFRuleSet
      name: owasp-crs-v4
  - ref:
      kind: WAFRuleSet
      name: shop-modsecurity
  skip:
    bodyPaths:
    - /upload/*
    paths:
    - /healthz
  targetRefs:
  - group: traefik.io
    kind: IngressRoute
    name: shop
--- stderr
note: no ConfigMap ingress-nginx/ingress-nginx-controller in the files: ModSecurity is taken as off globally (only the annotations count)
