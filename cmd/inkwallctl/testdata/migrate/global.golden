# From the ingress-nginx ModSecurity settings of Ingress web/admin.
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFPolicy
metadata:
  name: admin
  namespace: web
spec:
  exclusions:
  - ruleIDs:
    - 941100
    when:
      argument: body
      path: /admin/editor*
  mode: Block
  targetRefs:
  - kind: Ingress
    name: admin
---
# From the ingress-nginx ModSecurity settings of Ingress web/web.
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFPolicy
metadata:
  name: web
  namespace: web
spec:
  mode: Block
  targetRefs:
  - kind: Ingress
    name: web
