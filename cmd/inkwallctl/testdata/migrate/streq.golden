# From the ingress-nginx ModSecurity settings of Ingress shop/web.
# 2 setting(s) were not migrated: see the summary of inkwallctl migrate.
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFPolicy
metadata:
  name: web
  namespace: shop
spec:
  exclusions:
  - ruleIDs:
    - 920100
    when:
      path: /form*
  mode: Block
  targetRefs:
  - kind: Ingress
    name: web
