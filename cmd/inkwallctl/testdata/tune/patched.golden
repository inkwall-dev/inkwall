---
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFPolicy
metadata:
  name: storefront
  namespace: shop
spec:
  exclusions:
  - ruleIDs:
    - 942440
    when:
      cookie: session_hint
      path: /account
  - ruleIDs:
    - 920350
    when:
      header: Referer
      path: /account
  - ruleIDs:
    - 942200
    when:
      argumentName: select
      path: /api/import
  - ruleIDs:
    - 942100
    - 942430
    when:
      argument: q
      path: /search
  mode: Block
  ruleSets:
  - inboundAnomalyThreshold: 5
    paranoiaLevel: 1
    ref:
      kind: ClusterWAFRuleSet
      name: owasp-crs-v4
  - ref:
      kind: WAFRuleSet
      name: shop-custom
  skip:
    paths:
    - /health
  targetRefs:
  - kind: Ingress
    name: storefront
---
apiVersion: waf.inkwall.dev/v1alpha1
kind: WAFPolicy
metadata:
  name: api
  namespace: shop
spec:
  exclusions:
  - ruleIDs:
    - 100100
    when:
      argument: debug
      path: /api/orders
  mode: Detect
  ruleSets:
  - ref:
      kind: WAFRuleSet
      name: api-rules
  targetRefs:
  - kind: Ingress
    name: api
