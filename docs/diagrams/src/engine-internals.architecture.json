  "cards": [
    {
      "dot": "cyan",
      "title": "How the verdict returns",
      "items": [
        "Every adapter turns its input into one request.Request and calls pipeline.Check",
        "Reverse proxy: forwards, or answers the deny status",
        "Forward-auth: 200 to allow, otherwise the deny status for Traefik to return",
        "Check API: a CheckResponse with action, status and matched rules"
      ]
    },
    {
      "dot": "rose",
      "title": "When inspection fails",
      "items": [
        "Timeout, evaluator error or no free slot: 503 in block mode, allow and log in detect mode",
        "Bodies over --max-body-bytes: 413 in block mode"
      ]
    },
    {
      "dot": "amber",
      "title": "Not built yet (0005 §3)",
      "items": [
        "ext_authz, ext_proc and SPOE adapters",
        "Policy snapshots and signed bundles, IP lists and rate limits",
        "Event shipping beyond the JSON log"
      ]
    }
  ]
