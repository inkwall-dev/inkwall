  "cards": [
    {
      "dot": "rose",
      "title": "Middleware settings that matter",
      "items": [
        "trustForwardHeader: false, or a client's own X-Forwarded-Uri is inspected instead of the real one",
        "forwardBody: true with maxBodySize above --max-body-bytes, or bodies pass uninspected"
      ]
    },
    {
      "dot": "amber",
      "title": "When inspection cannot finish",
      "items": [
        "Timeout, evaluator error or overload: 503 in block mode, 200 and a logged event in detect mode",
        "Body over --max-body-bytes: 413 in block mode"
      ]
    },
    {
      "dot": "cyan",
      "title": "Client address",
      "items": [
        "Traefik is the direct peer; with --trusted-proxies=127.0.0.1/32 the engine takes the client from X-Forwarded-For"
      ]
    }
  ]
